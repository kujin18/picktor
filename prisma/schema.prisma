generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ACTOR
  CASTER
  ADMIN
}

enum CastingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String   @unique
  password     String

  role         UserRole @default(ACTOR)

  actorProfile ActorProfile?

  bookmarks    Bookmark[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActorProfile {
  id            String   @id @default(cuid())

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  name          String
  birthYear     Int?

  gender        String?

  height        Int?
  weight        Int?

  region        String?

  profileImage  String?

  introduction  String?

  videos        Video[]

  tags          ActorTag[]

  castingRequests CastingRequest[]

  bookmarks     Bookmark[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Video {
  id            String   @id @default(cuid())

  actorId       String
  actor         ActorProfile @relation(fields: [actorId], references: [id])

  title         String

  description   String?

  videoUrl      String

  thumbnailUrl  String?

  duration      Int?

  createdAt     DateTime @default(now())
}

model Tag {
  id            String   @id @default(cuid())

  name          String   @unique

  actors        ActorTag[]
}

model ActorTag {
  id            String   @id @default(cuid())

  actorId       String
  tagId         String

  actor         ActorProfile @relation(fields: [actorId], references: [id])
  tag           Tag          @relation(fields: [tagId], references: [id])

  @@unique([actorId, tagId])
}

model Bookmark {
  id            String @id @default(cuid())

  userId        String
  actorId       String

  user          User         @relation(fields: [userId], references: [id])
  actor         ActorProfile @relation(fields: [actorId], references: [id])

  @@unique([userId, actorId])
}

model CastingRequest {
  id            String @id @default(cuid())

  actorId       String

  actor         ActorProfile @relation(fields: [actorId], references: [id])

  companyName   String

  managerName   String?

  email         String?

  phone         String?

  message       String

  status        CastingStatus @default(PENDING)

  createdAt     DateTime @default(now())
}